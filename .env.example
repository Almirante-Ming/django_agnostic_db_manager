# django-db-portability -- example configuration
#
# IMPORTANT: this app reads DJANGO SETTINGS, not environment variables.
# Nothing here is picked up from the environment automatically. The file
# documents the six knobs and which of them you actually need; set them
# directly in settings.py, or read them from the environment the way your
# project already does (the `env(...)` forms below are for reference, in
# django-environ style).
#
# EVERY SETTING IS OPTIONAL. With none of them set, both commands already
# work for FULL database extraction and import:
#
#   manage.py extract_database
#   manage.py import_database --input <package>
#
# The first four unlock the per-department (per-tenant) scope,
# `extract_database --department <label>`. The last two are cosmetic or
# additive: an optional upload step and the package filename prefix.
#
# The placeholder values below describe an imaginary project with two
# tenant apps, `sales` and `support`, sharing a `people` app whose
# `people.Person` is subclassed by `sales.SalesPerson` and
# `support.SupportPerson` through multi-table inheritance. Replace them
# with your own app labels and models.


# ---------------------------------------------------------------------
# Per-department (tenant) scope
# ---------------------------------------------------------------------

# App labels treated as departments/tenants.
# Unset => `--department` rejects every value; full extraction only.
#   settings.py:  DB_PORTABILITY_DEPARTMENTS = ["sales", "support"]
#   django-environ: env.list("DB_PORTABILITY_DEPARTMENTS", default=[])
DB_PORTABILITY_DEPARTMENTS=sales,support

# App label holding the records shared across departments -- the app whose
# rows get filtered down to "just this department's" on a scoped
# extraction.
# Unset => a department package carries only that department's own app.
#   settings.py:  DB_PORTABILITY_SHARED_APP = "people"
DB_PORTABILITY_SHARED_APP=people

# The shared "person" model that each department app subclasses through
# Django multi-table inheritance. This is what lets the app work out, by
# introspection, which shared-app rows belong to a department -- including
# anything pointing at it through a FK/O2O, which is discovered
# automatically and needs no configuration at all.
# Unset => no person-based closure (the setting below still applies).
#   settings.py:  DB_PORTABILITY_PERSON_MODEL = "people.Person"
DB_PORTABILITY_PERSON_MODEL=people.Person

# Shared-app models scoped to a department by a plain FIELD VALUE instead
# of a foreign key to the person model -- the only case introspection
# cannot infer. Maps "app.Model" -> the field compared against the
# department label.
#
# This one is a dict, so it has no sensible flat-env form. Set it in
# settings.py directly:
#   DB_PORTABILITY_DEPARTMENT_SCOPED_MODELS = {
#       "people.BrandingConfig": "department",
#   }
# Unset => {} (FK-reachable models are still included automatically).


# ---------------------------------------------------------------------
# Optional upload step
# ---------------------------------------------------------------------

# Dotted path to a callable run after a package is written, to copy it off
# the server (object storage, a cloud drive, anything).
#   signature: callback(path: str, folder_id=None) -> dict
#
# The local .tar.gz under BASE_DIR/db_extracts/ is ALWAYS written first and
# never deleted, so a failing or unconfigured callback only ever means
# "local copy only" -- never a lost extraction.
#
# Whatever SDK the callback needs is YOUR project's dependency; this app
# never imports it, it only resolves the dotted path at call time.
# Unset => no upload is attempted.
#   settings.py:  DB_PORTABILITY_UPLOAD_CALLBACK = "myproject.storage.upload_backup"
DB_PORTABILITY_UPLOAD_CALLBACK=myproject.storage.upload_backup


# ---------------------------------------------------------------------
# Cosmetic
# ---------------------------------------------------------------------

# Filename prefix for generated packages, giving
# `<prefix>-<timestamp>.tar.gz`. Import accepts any filename, so changing
# this never invalidates packages you already have.
# Unset => "db-extract"
#   settings.py:  DB_PORTABILITY_ARCHIVE_PREFIX = "myproject-backup"
DB_PORTABILITY_ARCHIVE_PREFIX=myproject-backup
